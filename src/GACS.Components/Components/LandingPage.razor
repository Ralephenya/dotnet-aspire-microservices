@* ============================================================
   LandingPage.razor — Premium GACS public landing surface
   Used by: GACS.Web.Admin (Home.razor)
   Reference: FRONTEND-ARCHITECTURE.md Section 6

   Layout:
     1. Fixed navigation bar   — logo, nav links, Sign In + Request Demo
     2. Hero section           — dark gradient, headline, CTAs, trust badges
     3. Stats bar              — 4 key numbers
     4. Features section       — 6-item grid
     5. Surfaces section       — 4 front-end portals
     6. Architecture docs      — links to the 4 architecture .md files
     7. Footer                 — links, copyright

   Callbacks (wire in Home.razor):
     OnLogin       — called by every "Sign In" button
     OnRequestDemo — called by "Request Demo" button in nav/hero
   ============================================================ *@

<div class="gl-root">

    @* ── 1. NAVIGATION ── *@
    <nav class="gl-nav" role="navigation" aria-label="Main navigation">
        <div class="gl-nav-inner">

            @* Logo *@
            <a class="gl-nav-logo" href="/" aria-label="GACS home">
                <svg class="gl-nav-logo-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 2L3 7V11.5C3 16.5 6.5 21.26 12 23C17.5 21.26 21 16.5 21 11.5V7L12 2Z"
                          fill="#0F6CBD" />
                    <path d="M10.5 14.5L16 9L17 10L10.5 16.5L7 13L8 12L10.5 14.5Z"
                          fill="white" />
                </svg>
                <span class="gl-nav-logo-text">GACS</span>
                <span class="gl-nav-logo-badge">Admin</span>
            </a>

            @* Desktop links *@
            <ul class="gl-nav-links" role="list">
                <li><a class="gl-nav-link" href="#features">Features</a></li>
                <li><a class="gl-nav-link" href="#surfaces">Portals</a></li>
                <li><a class="gl-nav-link" href="#architecture">Architecture</a></li>
            </ul>

            @* CTA buttons *@
            <div class="gl-nav-actions">
                <button class="gl-btn gl-btn-ghost" @onclick="OnLoginClick" type="button">
                    Sign In
                </button>
                <button class="gl-btn gl-btn-primary" @onclick="OnRequestDemoClick" type="button">
                    Request Demo
                </button>
            </div>

            @* Mobile hamburger *@
            <button class="gl-nav-hamburger" @onclick="ToggleMenu" type="button"
                    aria-label="Toggle menu" aria-expanded="@_menuOpen">
                <span></span><span></span><span></span>
            </button>
        </div>

        @* Mobile menu *@
        @if (_menuOpen)
        {
            <div class="gl-nav-mobile-menu" role="menu">
                <a class="gl-nav-mobile-link" href="#features"   @onclick="() => _menuOpen = false">Features</a>
                <a class="gl-nav-mobile-link" href="#surfaces"   @onclick="() => _menuOpen = false">Portals</a>
                <a class="gl-nav-mobile-link" href="#architecture" @onclick="() => _menuOpen = false">Architecture</a>
                <div class="gl-nav-mobile-actions">
                    <button class="gl-btn gl-btn-ghost gl-btn-full" @onclick="OnLoginClick" type="button">Sign In</button>
                    <button class="gl-btn gl-btn-primary gl-btn-full" @onclick="OnRequestDemoClick" type="button">Request Demo</button>
                </div>
            </div>
        }
    </nav>

    @* ── 2. HERO ── *@
    <section class="gl-hero" aria-label="Introduction">
        <div class="gl-hero-grid-overlay" aria-hidden="true"></div>
        <div class="gl-hero-glow" aria-hidden="true"></div>

        <div class="gl-hero-inner">

            @* Trust pill *@
            <div class="gl-hero-pill" role="note">
                <span class="gl-hero-pill-dot" aria-hidden="true"></span>
                POPIA Compliant &nbsp;·&nbsp; Entra ID &nbsp;·&nbsp; .NET 10 &nbsp;·&nbsp; Aspire
            </div>

            <h1 class="gl-hero-title">
                Secure.<br />
                Compliant.<br />
                <span class="gl-hero-title-accent">Gated Access.</span>
            </h1>

            <p class="gl-hero-subtitle">
                Real-time visitor management, AI-powered risk scoring, and full POPIA audit compliance —
                purpose-built for gated residential communities and commercial estates across South Africa.
            </p>

            <div class="gl-hero-actions">
                <button class="gl-btn gl-btn-white gl-btn-lg" @onclick="OnLoginClick" type="button">
                    Sign In to Admin Portal
                    <svg class="gl-btn-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M3 8a.5.5 0 01.5-.5h7.293L8.146 4.854a.5.5 0 11.708-.708l4 4a.5.5 0 010 .708l-4 4a.5.5 0 11-.708-.708L10.793 8.5H3.5A.5.5 0 013 8z"/>
                    </svg>
                </button>
                <a class="gl-btn gl-btn-outline-white gl-btn-lg" href="#features">
                    Explore Features
                </a>
            </div>

            @* Trust logos *@
            <div class="gl-hero-trust" role="list" aria-label="Technology partners">
                @foreach (var logo in _trustLogos)
                {
                    <div class="gl-trust-item" role="listitem">
                        <span class="gl-trust-dot" aria-hidden="true"></span>
                        <span>@logo</span>
                    </div>
                }
            </div>
        </div>
    </section>

    @* ── 3. STATS BAR ── *@
    <section class="gl-stats" aria-label="Key metrics">
        <div class="gl-container">
            <div class="gl-stats-grid" role="list">
                @foreach (var stat in _stats)
                {
                    <div class="gl-stat" role="listitem">
                        <span class="gl-stat-number">@stat.Value</span>
                        <span class="gl-stat-label">@stat.Label</span>
                    </div>
                }
            </div>
        </div>
    </section>

    @* ── 4. FEATURES ── *@
    <section class="gl-features" id="features" aria-labelledby="features-heading">
        <div class="gl-container">
            <div class="gl-section-header">
                <p class="gl-section-eyebrow">Why GACS</p>
                <h2 class="gl-section-title" id="features-heading">
                    Built for compliance.<br />Designed for speed.
                </h2>
                <p class="gl-section-subtitle">
                    Every feature exists to solve a real problem at South African gated estates —
                    from POPIA obligations to sub-2-second gate entry.
                </p>
            </div>
            <div class="gl-features-grid" role="list">
                @foreach (var feature in _features)
                {
                    <article class="gl-feature-card" role="listitem">
                        <div class="gl-feature-icon-wrap" aria-hidden="true">
                            @((MarkupString)feature.IconSvg)
                        </div>
                        <h3 class="gl-feature-title">@feature.Title</h3>
                        <p class="gl-feature-desc">@feature.Description</p>
                    </article>
                }
            </div>
        </div>
    </section>

    @* ── 5. SURFACES / PORTALS ── *@
    <section class="gl-surfaces" id="surfaces" aria-labelledby="surfaces-heading">
        <div class="gl-container">
            <div class="gl-section-header">
                <p class="gl-section-eyebrow">Four Portals</p>
                <h2 class="gl-section-title" id="surfaces-heading">
                    One codebase.<br />Every context.
                </h2>
                <p class="gl-section-subtitle">
                    All portals share the <code>GACS.Components</code> library and
                    are written in C# — no JavaScript framework switching.
                </p>
            </div>
            <div class="gl-surfaces-grid" role="list">
                @foreach (var surface in _surfaces)
                {
                    <article class="gl-surface-card" role="listitem">
                        <div class="gl-surface-card-top">
                            <div class="gl-surface-icon-wrap @surface.IconColor" aria-hidden="true">
                                @((MarkupString)surface.IconSvg)
                            </div>
                            <div class="gl-surface-badge">@surface.Tech</div>
                        </div>
                        <h3 class="gl-surface-title">@surface.Title</h3>
                        <p class="gl-surface-desc">@surface.Description</p>
                        <div class="gl-surface-footer">
                            <span class="gl-surface-audience-label">Audience</span>
                            <span class="gl-surface-audience">@surface.Audience</span>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    @* ── 6. ARCHITECTURE DOCS ── *@
    <section class="gl-arch" id="architecture" aria-labelledby="arch-heading">
        <div class="gl-container">
            <div class="gl-section-header gl-section-header-light">
                <p class="gl-section-eyebrow gl-section-eyebrow-light">Developer Reference</p>
                <h2 class="gl-section-title gl-section-title-light" id="arch-heading">
                    Start here before writing code.
                </h2>
                <p class="gl-section-subtitle gl-section-subtitle-light">
                    Four architecture documents define every decision made in this system.
                    Junior developers — read these before opening a file.
                </p>
            </div>
            <div class="gl-arch-grid" role="list">
                @foreach (var doc in _archDocs)
                {
                    <a class="gl-arch-card" href="@doc.Href" role="listitem" target="_blank" rel="noopener">
                        <div class="gl-arch-card-icon" aria-hidden="true">
                            @((MarkupString)doc.IconSvg)
                        </div>
                        <div class="gl-arch-card-body">
                            <h3 class="gl-arch-card-title">@doc.Title</h3>
                            <p class="gl-arch-card-desc">@doc.Description</p>
                        </div>
                        <div class="gl-arch-card-arrow" aria-hidden="true">
                            <svg viewBox="0 0 16 16" fill="currentColor">
                                <path d="M3 8a.5.5 0 01.5-.5h7.293L8.146 4.854a.5.5 0 11.708-.708l4 4a.5.5 0 010 .708l-4 4a.5.5 0 11-.708-.708L10.793 8.5H3.5A.5.5 0 013 8z"/>
                            </svg>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>

    @* ── 7. FOOTER ── *@
    <footer class="gl-footer" role="contentinfo">
        <div class="gl-container">
            <div class="gl-footer-inner">
                <div class="gl-footer-brand">
                    <svg class="gl-footer-logo-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M12 2L3 7V11.5C3 16.5 6.5 21.26 12 23C17.5 21.26 21 16.5 21 11.5V7L12 2Z" fill="#0F6CBD"/>
                        <path d="M10.5 14.5L16 9L17 10L10.5 16.5L7 13L8 12L10.5 14.5Z" fill="white"/>
                    </svg>
                    <div>
                        <div class="gl-footer-brand-name">GACS</div>
                        <div class="gl-footer-brand-tagline">Gated Access Compliance Suite</div>
                    </div>
                </div>

                <nav class="gl-footer-links" aria-label="Footer navigation">
                    <div class="gl-footer-link-group">
                        <p class="gl-footer-link-heading">Product</p>
                        <a class="gl-footer-link" href="#features">Features</a>
                        <a class="gl-footer-link" href="#surfaces">Portals</a>
                        <a class="gl-footer-link" href="#architecture">Architecture</a>
                    </div>
                    <div class="gl-footer-link-group">
                        <p class="gl-footer-link-heading">Compliance</p>
                        <a class="gl-footer-link" href="docs/DATA-ARCHITECTURE.md">POPIA</a>
                        <a class="gl-footer-link" href="docs/DATA-ARCHITECTURE.md">Data Retention</a>
                        <a class="gl-footer-link" href="docs/MASTER-ARCHITECTURE.md">Security</a>
                    </div>
                    <div class="gl-footer-link-group">
                        <p class="gl-footer-link-heading">Developers</p>
                        <a class="gl-footer-link" href="docs/FRONTEND-ARCHITECTURE.md">Frontend</a>
                        <a class="gl-footer-link" href="docs/BACKEND-ARCHITECTURE.md">Backend</a>
                        <a class="gl-footer-link" href="ONBOARDING.md">Onboarding</a>
                    </div>
                </nav>
            </div>

            <div class="gl-footer-bottom">
                <p class="gl-footer-copy">
                    &copy; @DateTime.Now.Year GACS — Gated Access Compliance Suite.
                    Built on .NET 10, Blazor Server, MAUI, and Microsoft Azure.
                </p>
                <p class="gl-footer-stack">
                    Fluent UI &nbsp;·&nbsp; Aspire &nbsp;·&nbsp; YARP &nbsp;·&nbsp; Wolverine &nbsp;·&nbsp; Dapper
                </p>
            </div>
        </div>
    </footer>

</div>

@code {
