{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ── YARP Route & Cluster Config ──────────────────────────────────────────────
  //
  // How routes work:
  //   Match.Path   — the URL pattern GACS.Web.Admin calls (e.g. /api/v1/tenants/...)
  //   ClusterId    — the downstream service cluster to forward to
  //
  // Service discovery:
  //   Destination Address uses Aspire service discovery names (https+http://gacs-*)
  //   These resolve to the actual host:port via ServiceDefaults.AddServiceDiscovery()
  //   You NEVER hard-code a port number here.
  //
  // Transforms:
  //   PathRemovePrefix removes /api from the forwarded path so the downstream
  //   controller sees the same path it declares on its [Route] attribute.
  //
  // Adding a new backend service:
  //   1. Add a route under Routes with a unique key and Match.Path pattern
  //   2. Add a cluster under Clusters pointing to the service's Aspire name
  //   3. Wire the service in AppHost Program.cs: .WithReference(gateway)
  // ────────────────────────────────────────────────────────────────────────────

  "ReverseProxy": {
    "Routes": {

      // ── Identity & Tenant service ──────────────────────────────────────────
      "tenants-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/{version}/tenants/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/{version}/tenants/{**catch-all}" }]
      },
      "users-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/{version}/users/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/{version}/users/{**catch-all}" }]
      },
      "apikeys-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/{version}/apikeys/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/{version}/apikeys/{**catch-all}" }]
      },

      // ── Future services — add routes here as new microservices are scaffolded ──
      // "visitors-route": {
      //   "ClusterId": "visitors-cluster",
      //   "Match": { "Path": "/api/{version}/visitors/{**catch-all}" }
      // },
      // "access-events-route": {
      //   "ClusterId": "access-cluster",
      //   "Match": { "Path": "/api/{version}/access-events/{**catch-all}" }
      // },

      // ── Swagger / Scalar pass-through (dev only — disable in production) ──
      "identity-scalar-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/scalar/{**catch-all}" }
      },
      "identity-openapi-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/openapi/{**catch-all}" }
      }
    },

    "Clusters": {

      // ── Identity Tenant API ──────────────────────────────────────────────────
      // Aspire service name: gacs-identitytenant-api (set in AppHost Program.cs)
      // Resolved by Aspire service discovery — never hard-code ports here
      "identity-cluster": {
        "Destinations": {
          "primary": {
            "Address": "https+http://gacs-identitytenant-api"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:10",
            "Path": "/health"
          }
        }
      }

      // ── Future clusters ──────────────────────────────────────────────────────
      // Add a new object here for each new backend service.
      // "visitors-cluster": {
      //   "Destinations": {
      //     "primary": { "Address": "https+http://gacs-visitors-api" }
      //   }
      // }
    }
  }
}
