@* ============================================================
   Dashboard.razor — Admin portal home dashboard at /dashboard
   This is a scaffold placeholder. Junior devs build the real
   dashboard here using AdminShell + Fluent UI components.

   Reference: FRONTEND-ARCHITECTURE.md Section 6 — AdminShell
   ============================================================ *@

@page "/dashboard"

<PageTitle>Dashboard — GACS Admin Portal</PageTitle>

@* AdminShell provides the top nav + collapsible sidebar layout.
   Replace the slot content below with real dashboard widgets. *@
<AdminShell>
    <TopBarContent>
        <span style="font-size: 14px; font-weight: 600; color: var(--colorNeutralForeground);">
            Admin Dashboard
        </span>
    </TopBarContent>

    <SidebarContent>
        @* TODO: Add FluentNavMenu with links to each admin section.
           Example sections: Sites | Visitors | Users | Compliance | Audit Log | Settings *@
        <div style="padding: 16px; font-size: 13px; color: var(--colorNeutralForegroundSubtle);">
            Navigation coming soon
        </div>
    </SidebarContent>

    <ChildContent>
        <div class="dash-placeholder">
            <div class="dash-placeholder-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                          stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <h1 class="dash-placeholder-title">Dashboard Scaffold</h1>
            <p class="dash-placeholder-desc">
                You're in the admin dashboard. This page is a scaffold placeholder —
                wire up real widgets using the component library in <code>GACS.Components</code>.
            </p>
            <div class="dash-placeholder-chips">
                <span class="dash-chip">ComplianceScoreRing</span>
                <span class="dash-chip">RiskBadge</span>
                <span class="dash-chip">VisitorProfileCard</span>
                <span class="dash-chip">GateStatusIndicator</span>
                <span class="dash-chip">RetentionCountdown</span>
                <span class="dash-chip">AiCoachingPanel</span>
            </div>
        </div>
    </ChildContent>
</AdminShell>

<style>
    .dash-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 70vh;
        text-align: center;
        padding: 48px 24px;
        gap: 16px;
    }

    .dash-placeholder-icon {
        width: 64px;
        height: 64px;
        color: var(--colorBrandPrimary);
        background: var(--colorBrandLight);
        border-radius: var(--radiusL);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }

    .dash-placeholder-icon svg { width: 100%; height: 100%; }

    .dash-placeholder-title {
        font-size: 28px;
        font-weight: 800;
        color: var(--colorNeutralForeground);
        letter-spacing: -0.5px;
        margin: 0;
    }

    .dash-placeholder-desc {
        font-size: 15px;
        line-height: 1.6;
        color: var(--colorNeutralForegroundSubtle);
        max-width: 520px;
        margin: 0;
    }

    .dash-placeholder-desc code {
        font-family: 'Cascadia Code', 'Fira Code', Consolas, monospace;
        font-size: 13px;
        background: var(--colorNeutralSurfaceAlt);
        color: var(--colorBrandPrimary);
        padding: 1px 6px;
        border-radius: 4px;
        border: 1px solid var(--colorNeutralBorder);
    }

    .dash-placeholder-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
        margin-top: 8px;
    }

    .dash-chip {
        font-size: 12px;
        font-weight: 600;
        font-family: 'Cascadia Code', 'Fira Code', Consolas, monospace;
        background: var(--colorNeutralSurfaceAlt);
        border: 1px solid var(--colorNeutralBorder);
        color: var(--colorNeutralForeground);
        padding: 5px 12px;
        border-radius: var(--radiusFull);
    }
</style>
