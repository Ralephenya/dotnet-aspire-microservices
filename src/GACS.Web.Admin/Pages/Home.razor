@* ============================================================
   Home.razor — Public landing page at /
   Uses the LandingPage component from GACS.Components.
   ============================================================ *@

@page "/"
@inject NavigationManager Navigation

<PageTitle>GACS — Gated Access Compliance Suite</PageTitle>

<LandingPage OnLogin="GoToLogin" OnRequestDemo="GoToLogin" />

@code {
    private void GoToLogin()       => Navigation.NavigateTo("/login");
}
