@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace GACS.Web.Admin.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />

    @* ── Google Fonts — Inter (loaded as <link>, never @import — avoids parse blocking) ── *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" />

    @* ── GACS design tokens (CSS custom properties — colours, spacing, shadows, radii) ── *@
    <link rel="stylesheet" href="_content/GACS.Components/gacs-tokens.css" />

    @* ── Global baseline (reset, scrollbar, Blazor error UI) ── *@
    <link rel="stylesheet" href="css/site.css" />

    @* ── Scoped component CSS bundle (auto-generated from all .razor.css files) ── *@
    <link href="GACS.Web.Admin.styles.css" rel="stylesheet" />

    @* ── Fluent UI web components script (must be type=module, loads after DOM) ── *@
    <script src="_content/Microsoft.FluentUI.AspNetCore.Components/Microsoft.FluentUI.AspNetCore.Components.lib.module.js"
            type="module" async></script>

    <link rel="icon" type="image/png" href="favicon.png" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">&#x2715;</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
</body>
</html>
