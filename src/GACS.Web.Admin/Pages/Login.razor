@page "/login"
@inject NavigationManager Navigation

<PageTitle>Sign In — GACS Admin Portal</PageTitle>

<LoginPage OnSignIn="HandleSignIn" OnGoHome="GoHome" />

@code {
    /// <summary>
    /// Called when the user clicks "Sign in with Microsoft".
    /// TODO: Replace body with Microsoft.Identity.Web challenge redirect.
    /// </summary>
    private void HandleSignIn()
    {
        // Scaffold placeholder — redirects to dashboard.
        // Production: Navigation.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
        Navigation.NavigateTo("/dashboard");
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }
}
